{
  "version": 4,
  "defaults": {
    "runner": "claude-code",
    "editor": "code",
    "base_branch": "main",
    "execution_profile": "personal"
  },
  "runner_defaults": {
    "claude-code": {
      "model": "opus-4.7",
      "effort": "max",
      "permission_mode": "acceptEdits"
    },
    "codex": {
      "model": "gpt-5.4",
      "effort": "xhigh"
    },
    "cursor": {
      "model": "sonnet-4.6-thinking"
    }
  },
  "runners": {
    "claude-code": "claude",
    "codex": "codex"
  },
  "editors": {
    "code": "code"
  },
  "execution_profiles": {
    "personal": {
      "env": {
        "ANTHROPIC_API_KEY": "personal-anthropic",
        "OPENAI_API_KEY": "personal-openai"
      }
    },
    "work": {
      "env": {
        "ANTHROPIC_API_KEY": "work-anthropic"
      }
    }
  }
}
